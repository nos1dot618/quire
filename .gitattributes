# Normalize text files in the repository; check out with native line endings.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.slnx    text
*.md      text
*.yml     text
*.json    text
*.py      text eol=lf
*.sh      text eol=lf

*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.quire   binary
*.zip     binary
