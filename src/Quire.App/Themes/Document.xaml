<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Document canvas styling. Colors are DynamicResource keys (Quire.*) defined by the active
        palette in Themes/Palettes, which ThemeManager swaps for light, dark, or high contrast.
        Every surface here is square-cornered, with no gradients or shadows.
    -->

    <FontFamily x:Key="DocumentFont">Segoe UI</FontFamily>
    <FontFamily x:Key="CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Read-only rendered view of Markdown or code; looks like text on the page. -->
    <Style x:Key="PreviewBox" TargetType="RichTextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Quire.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Quire.TextSelection}" />
        <Setter Property="IsDocumentEnabled" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="IsUndoEnabled" Value="False" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- Borderless text box that reads as part of the page until focused. -->
    <Style x:Key="InlineTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DocumentFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Quire.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Quire.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Quire.TextSelection}" />
        <!-- Keeps find results visible while focus stays in the find box. -->
        <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <!-- Undo is document-wide (Edit > Undo), so each box's private undo is off. -->
        <Setter Property="IsUndoEnabled" Value="False" />
    </Style>

    <Style x:Key="CellNameBox" TargetType="TextBox" BasedOn="{StaticResource InlineTextBox}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{DynamicResource Quire.Text}" />
        <Setter Property="AutomationProperties.Name" Value="Cell name" />
    </Style>

    <Style x:Key="CodeTextBox" TargetType="TextBox" BasedOn="{StaticResource InlineTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource Quire.CodeBackground}" />
    </Style>

    <Style x:Key="ElementCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Quire.Muted}" />
        <Setter Property="Margin" Value="0,0,0,1" />
    </Style>

    <!--
        Cells: each is its own square panel on a slightly darker canvas, separated by a clear gap,
        with a header strip for the name. The selected cell gets an accent border and a bar on the
        left. Flat colors only: no shadows, gradients or rounded corners.
    -->
    <Style x:Key="CellContainer" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!-- Long lines stay readable on wide screens; the column is centred. -->
        <Setter Property="MaxWidth" Value="1080" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Frame"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Quire.CellBorder}"
                            Background="{DynamicResource Quire.CellBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Bar" Background="Transparent" />
                            <ContentPresenter Grid.Column="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Quire.CellBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Quire.Accent}" />
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Quire.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header strip at the top of each cell, holding its name. -->
    <Style x:Key="CellHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Quire.CellHeader}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Quire.CellBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="11,5,12,5" />
    </Style>

</ResourceDictionary>
