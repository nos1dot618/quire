<Window x:Class="Quire.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Quire.Models"
        xmlns:ui="clr-namespace:Quire.UI"
        Title="{Binding WindowTitle}"
        Icon="/Quire;component/Assets/Quire.ico"
        Width="960" Height="720"
        MinWidth="400" MinHeight="300"
        Background="{DynamicResource Quire.Canvas}"
        Foreground="{DynamicResource Quire.Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ui:AssetImageConverter x:Key="AssetImage" />
        <ui:AssetBytesConverter x:Key="AssetBytes" />
        <ui:AssetSizeConverter x:Key="AssetSize" />
        <ui:NullToVisibleConverter x:Key="NullToVisible" />
        <ui:FileExistsConverter x:Key="FileExists" />

        <!-- Shared by every element; its DataContext is the element it was opened on. -->
        <ContextMenu x:Key="ElementMenu" x:Shared="False">
            <MenuItem Header="Move Up" Click="MoveElementUp_Click" InputGestureText="Alt+Shift+Up" />
            <MenuItem Header="Move Down" Click="MoveElementDown_Click" InputGestureText="Alt+Shift+Down" />
            <MenuItem Header="Convert To">
                <MenuItem Header="Text" Click="ConvertToText_Click" />
                <MenuItem Header="Markdown" Click="ConvertToMarkdown_Click" />
                <MenuItem Header="Code" Click="ConvertToCode_Click" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete" Click="DeleteElement_Click" InputGestureText="Ctrl+Shift+Del" />
        </ContextMenu>

        <ContextMenu x:Key="ImageMenu" x:Shared="False">
            <MenuItem Header="Copy Image" Click="CopyImage_Click" />
            <MenuItem Header="Save a Copy…" Click="SaveAsset_Click" />
            <MenuItem Header="Open in Default Viewer" Click="OpenImage_Click" />
            <MenuItem Header="Replace…" Click="ReplaceImage_Click" />
            <Separator />
            <MenuItem Header="Move Up" Click="MoveElementUp_Click" InputGestureText="Alt+Shift+Up" />
            <MenuItem Header="Move Down" Click="MoveElementDown_Click" InputGestureText="Alt+Shift+Down" />
            <Separator />
            <MenuItem Header="Delete" Click="DeleteElement_Click" InputGestureText="Ctrl+Shift+Del" />
        </ContextMenu>

        <ContextMenu x:Key="CellMenu">
            <MenuItem Header="Rename" Command="{Binding RenameCellCommand}" InputGestureText="F2" />
            <MenuItem Header="Duplicate" Command="{Binding DuplicateCellCommand}" InputGestureText="Ctrl+D" />
            <MenuItem Header="Move Up" Command="{Binding MoveCellUpCommand}" InputGestureText="Alt+Up" />
            <MenuItem Header="Move Down" Command="{Binding MoveCellDownCommand}" InputGestureText="Alt+Down" />
            <Separator />
            <MenuItem Header="Delete" Command="{Binding DeleteCellCommand}" />
        </ContextMenu>

        <!-- Element templates, chosen by element type. -->

        <DataTemplate DataType="{x:Type models:TextElement}">
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InlineTextBox}"
                     AutomationProperties.Name="Text" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:MarkdownElement}">
            <ui:SourcePreviewPanel IsPreviewEnabled="{Binding DataContext.IsPreviewMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Editor="{Binding ElementName=Source}" Preview="{Binding ElementName=Rendered}">
                <StackPanel Visibility="{Binding Visibility, ElementName=Source}">
                    <TextBlock Text="Markdown" Style="{StaticResource ElementCaption}" />
                    <TextBox x:Name="Source"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InlineTextBox}"
                             FontFamily="{StaticResource CodeFont}" FontSize="13"
                             AutomationProperties.Name="Markdown source" />
                </StackPanel>
                <RichTextBox x:Name="Rendered" Style="{StaticResource PreviewBox}" Visibility="Collapsed"
                             ToolTip="Click to edit the Markdown"
                             AutomationProperties.Name="Markdown preview" />
            </ui:SourcePreviewPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:CodeElement}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Code" Style="{StaticResource ElementCaption}" DockPanel.Dock="Left" Margin="0,0,6,1" />
                    <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InlineTextBox}" FontSize="11" Padding="0"
                             AcceptsReturn="False" TextWrapping="NoWrap" MinWidth="80"
                             HorizontalAlignment="Left"
                             Foreground="{DynamicResource Quire.Muted}"
                             ToolTip="Language"
                             AutomationProperties.Name="Code language" />
                </DockPanel>
                <ui:SourcePreviewPanel IsPreviewEnabled="{Binding DataContext.IsPreviewMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Editor="{Binding ElementName=Source}" Preview="{Binding ElementName=Highlighted}">
                    <TextBox x:Name="Source"
                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CodeTextBox}"
                             AutomationProperties.Name="Code" />
                    <Border Background="{DynamicResource Quire.CodeBackground}"
                            Visibility="{Binding Visibility, ElementName=Highlighted}" Padding="6,4">
                        <RichTextBox x:Name="Highlighted" Style="{StaticResource PreviewBox}" Visibility="Collapsed"
                                     FontFamily="{StaticResource CodeFont}" FontSize="13" Padding="0"
                                     ToolTip="Click to edit the code"
                                     AutomationProperties.Name="Highlighted code" />
                    </Border>
                </ui:SourcePreviewPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:LinkElement}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Link" Style="{StaticResource ElementCaption}" Margin="0,3,8,0" />
                <TextBox Grid.Column="1"
                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InlineTextBox}" AcceptsReturn="False"
                         Foreground="{DynamicResource Quire.Link}"
                         AutomationProperties.Name="Link address" />
                <TextBlock Grid.Row="1" Text="Title" Style="{StaticResource ElementCaption}" Margin="0,3,8,0" />
                <DockPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock DockPanel.Dock="Right" Margin="8,2,0,0">
                        <Hyperlink Click="OpenLink_Click">Open</Hyperlink>
                    </TextBlock>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InlineTextBox}" AcceptsReturn="False"
                             AutomationProperties.Name="Link title" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssetImageTemplate">
            <StackPanel HorizontalAlignment="Left">
                <Image x:Name="Picture" Stretch="Uniform" StretchDirection="DownOnly"
                       MaxHeight="640" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="Image">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource AssetImage}">
                            <Binding Path="Asset" />
                            <Binding Path="DataContext.Document" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
                <Border BorderThickness="1" Padding="8,6"
                        BorderBrush="{DynamicResource Quire.Rule}"
                        Visibility="{Binding Source, ElementName=Picture, Converter={StaticResource NullToVisible}}">
                    <TextBlock Foreground="{DynamicResource Quire.Muted}">
                        <Run Text="Image unavailable:" />
                        <Run Text="{Binding Asset, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ImageElement}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AssetImageTemplate}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:GifElement}">
            <StackPanel HorizontalAlignment="Left">
                <ui:AnimatedImage x:Name="Picture" Stretch="Uniform" StretchDirection="DownOnly"
                                  MaxHeight="640" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"
                                  AutomationProperties.Name="Animated image">
                    <ui:AnimatedImage.GifData>
                        <MultiBinding Converter="{StaticResource AssetBytes}">
                            <Binding Path="Asset" />
                            <Binding Path="DataContext.Document" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </ui:AnimatedImage.GifData>
                </ui:AnimatedImage>
                <Border BorderThickness="1" Padding="8,6"
                        BorderBrush="{DynamicResource Quire.Rule}"
                        Visibility="{Binding Source, ElementName=Picture, Converter={StaticResource NullToVisible}}">
                    <TextBlock Foreground="{DynamicResource Quire.Muted}">
                        <Run Text="Image unavailable:" />
                        <Run Text="{Binding Asset, Mode=OneWay}" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:AttachmentElement}">
            <TextBlock>
                <Run Text="Attachment" Foreground="{DynamicResource Quire.Muted}" FontSize="11" />
                <Run Text="  " />
                <Run Text="{Binding FileName, Mode=OneWay}" />
                <Run Foreground="{DynamicResource Quire.Muted}">
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource AssetSize}" StringFormat="({0})" Mode="OneWay">
                            <Binding Path="Asset" />
                            <Binding Path="DataContext.Document" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </Run.Text>
                </Run>
                <Run Text="  " />
                <Hyperlink Click="SaveAsset_Click">Save a copy…</Hyperlink>
            </TextBlock>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:FileReferenceElement}">
            <DockPanel>
                <TextBlock Text="File" Style="{StaticResource ElementCaption}" Margin="0,3,8,0" DockPanel.Dock="Left" />
                <TextBlock DockPanel.Dock="Right" Margin="8,2,0,0">
                    <Run Text="{Binding Path, Mode=OneWay, Converter={StaticResource FileExists}}"
                         Foreground="{DynamicResource Quire.Muted}" />
                    <Hyperlink Click="RevealFile_Click">Show in folder</Hyperlink>
                </TextBlock>
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InlineTextBox}" AcceptsReturn="False"
                         FontFamily="{StaticResource CodeFont}" FontSize="13"
                         AutomationProperties.Name="File path" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:DividerElement}">
            <Border Height="1" Margin="0,6" Background="{DynamicResource Quire.Rule}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:UnknownElement}">
            <TextBlock Foreground="{DynamicResource Quire.Muted}" TextWrapping="Wrap">
                <Run Text="Unsupported element type" />
                <Run Text="{Binding OriginalType, Mode=OneWay}" />
                <Run Text="(kept as-is when saving)" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="CellTemplate" DataType="{x:Type models:Cell}">
            <StackPanel>
                <Border Style="{StaticResource CellHeader}">
                    <Grid>
                        <!-- Shown in place of an empty name, so unnamed cells still read as cells. -->
                        <TextBlock x:Name="NamePlaceholder" Text="Untitled cell" Margin="2,2,0,0"
                                   FontSize="13" FontStyle="Italic" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Quire.Muted}" Visibility="Collapsed" />
                        <TextBox x:Name="CellName"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CellNameBox}"
                                 Tag="CellName" />
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Elements}" Focusable="False" Margin="12,8,12,10">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="ContextMenu" Value="{StaticResource ElementMenu}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TypeName}" Value="image">
                                    <Setter Property="ContextMenu" Value="{StaticResource ImageMenu}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TypeName}" Value="gif">
                                    <Setter Property="ContextMenu" Value="{StaticResource ImageMenu}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Name}" Value="" />
                        <Condition Binding="{Binding IsKeyboardFocused, ElementName=CellName}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NamePlaceholder" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding InsertCellCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCellCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding RenameCellCommand}" />
        <KeyBinding Gesture="Alt+Up" Command="{Binding MoveCellUpCommand}" />
        <KeyBinding Gesture="Alt+Down" Command="{Binding MoveCellDownCommand}" />
        <KeyBinding Gesture="Alt+Shift+Up" Command="{Binding MoveElementUpCommand}" />
        <KeyBinding Gesture="Alt+Shift+Down" Command="{Binding MoveElementDownCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Delete" Command="{Binding DeleteElementCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem x:Name="RecentMenu" Header="_Recent Documents" SubmenuOpened="RecentMenu_SubmenuOpened">
                    <MenuItem Header="(none)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Export">
                    <MenuItem Header="_Markdown…" Command="{Binding ExportCommand}" CommandParameter="Markdown" />
                    <MenuItem Header="_PDF…" Command="{Binding ExportCommand}" CommandParameter="Pdf" />
                    <MenuItem Header="_HTML…" Command="{Binding ExportCommand}" CommandParameter="Html" />
                    <MenuItem Header="Plain _Text…" Command="{Binding ExportCommand}" CommandParameter="PlainText" />
                    <Separator />
                    <MenuItem Header="Include _Cell Names as Headings" IsCheckable="True" IsChecked="{Binding ExportCellNames}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Command="ApplicationCommands.Undo" />
                <MenuItem Command="ApplicationCommands.Redo" />
                <Separator />
                <MenuItem Command="ApplicationCommands.Cut" />
                <MenuItem Command="ApplicationCommands.Copy" />
                <MenuItem Command="ApplicationCommands.Paste" />
                <MenuItem Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem Header="_Find…" Click="Find_Click" InputGestureText="Ctrl+F" />
                <MenuItem Header="Find _Next" Click="FindNext_Click" InputGestureText="F3" />
                <MenuItem Header="Find Pre_vious" Click="FindPrevious_Click" InputGestureText="Shift+F3" />
            </MenuItem>
            <MenuItem Header="_Insert">
                <MenuItem Header="_Cell" Command="{Binding InsertCellCommand}" InputGestureText="Ctrl+Shift+N" />
                <Separator />
                <MenuItem Header="_Text" Command="{Binding InsertTextCommand}" />
                <MenuItem Header="_Markdown" Command="{Binding InsertMarkdownCommand}" />
                <MenuItem Header="C_ode" Command="{Binding InsertCodeCommand}" />
                <MenuItem Header="_Image…" Command="{Binding InsertImageCommand}" />
                <MenuItem Header="_Link" Command="{Binding InsertLinkCommand}" />
                <MenuItem Header="_File">
                    <MenuItem Header="_Reference to File…" Command="{Binding InsertFileReferenceCommand}"
                              ToolTip="Stores the file's path. The file stays where it is." />
                    <MenuItem Header="_Attach Copy of File…" Command="{Binding InsertAttachmentCommand}"
                              ToolTip="Copies the file into the document so it travels with it." />
                </MenuItem>
                <MenuItem Header="_Divider" Command="{Binding InsertDividerCommand}" />
                <Separator />
                <MenuItem Header="Dropped and Pasted _Files">
                    <MenuItem Header="_Reference Original" IsCheckable="True" IsChecked="{Binding ReferenceDroppedFiles}"
                              ToolTip="Store the path. Hold Ctrl while dropping to attach a copy instead." />
                    <MenuItem Header="_Attach Copy" IsCheckable="True" IsChecked="{Binding AttachDroppedFiles}"
                              ToolTip="Copy into the document. Hold Ctrl while dropping to reference instead." />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Cell">
                <MenuItem Header="_Rename" Command="{Binding RenameCellCommand}" InputGestureText="F2" />
                <MenuItem Header="_Duplicate" Command="{Binding DuplicateCellCommand}" InputGestureText="Ctrl+D" />
                <MenuItem Header="Move _Up" Command="{Binding MoveCellUpCommand}" InputGestureText="Alt+Up" />
                <MenuItem Header="Move Do_wn" Command="{Binding MoveCellDownCommand}" InputGestureText="Alt+Down" />
                <MenuItem Header="De_lete" Command="{Binding DeleteCellCommand}" />
                <Separator />
                <MenuItem Header="_Convert Element To">
                    <MenuItem Header="_Text" Command="{Binding ConvertToTextCommand}" />
                    <MenuItem Header="_Markdown" Command="{Binding ConvertToMarkdownCommand}" />
                    <MenuItem Header="_Code" Command="{Binding ConvertToCodeCommand}" />
                </MenuItem>
                <MenuItem Header="Move Element U_p" Command="{Binding MoveElementUpCommand}" InputGestureText="Alt+Shift+Up" />
                <MenuItem Header="Move Element Dow_n" Command="{Binding MoveElementDownCommand}" InputGestureText="Alt+Shift+Down" />
                <MenuItem Header="Delete _Element" Command="{Binding DeleteElementCommand}" InputGestureText="Ctrl+Shift+Del" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Theme">
                    <MenuItem Header="Use _Windows Setting" IsCheckable="True" IsChecked="{Binding IsSystemTheme}" />
                    <MenuItem Header="_Light" IsCheckable="True" IsChecked="{Binding IsLightTheme}" />
                    <MenuItem Header="_Dark" IsCheckable="True" IsChecked="{Binding IsDarkTheme}" />
                </MenuItem>
                <MenuItem Header="_Zoom">
                    <MenuItem Header="Zoom _In" Click="ZoomIn_Click" InputGestureText="Ctrl+=" />
                    <MenuItem Header="Zoom _Out" Click="ZoomOut_Click" InputGestureText="Ctrl+-" />
                    <MenuItem Header="_Reset" Click="ZoomReset_Click" InputGestureText="Ctrl+0" />
                </MenuItem>
                <MenuItem Header="_Preview Mode" IsCheckable="True" IsChecked="{Binding IsPreviewMode}"
                          ToolTip="Show rendered Markdown and highlighted code until clicked" />
                <MenuItem Header="_Full Screen" Click="FullScreen_Click" InputGestureText="F11" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Click="Shortcuts_Click" InputGestureText="F1" />
                <MenuItem Header="_About Quire" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Find bar: shown only while searching (Ctrl+F), never a permanent toolbar. -->
        <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Quire.Chrome}" BorderBrush="{DynamicResource Quire.Rule}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource ChromeButton}" Margin="4,0,0,0" Click="CloseFind_Click"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close find" />
                <Button DockPanel.Dock="Right" Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource ChromeButton}" Margin="4,0,0,0" Click="FindNext_Click"
                        ToolTip="Next (Enter, F3)" AutomationProperties.Name="Next match" />
                <Button DockPanel.Dock="Right" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Style="{StaticResource ChromeButton}" Margin="4,0,0,0" Click="FindPrevious_Click"
                        ToolTip="Previous (Shift+Enter, Shift+F3)" AutomationProperties.Name="Previous match" />
                <TextBlock x:Name="FindStatus" DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Quire.Muted}" MinWidth="70" TextAlignment="Right" />
                <TextBox x:Name="FindBox" Style="{StaticResource ChromeTextBox}" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"
                         TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"
                         AutomationProperties.Name="Find" />
            </DockPanel>
        </Border>

        <ListBox x:Name="Cells"
                 ItemsSource="{Binding Document.Cells}"
                 SelectedItem="{Binding SelectedCell}"
                 ItemTemplate="{StaticResource CellTemplate}"
                 ItemContainerStyle="{StaticResource CellContainer}"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="{DynamicResource Quire.Text}"
                 Padding="20,16"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False"
                 KeyboardNavigation.TabNavigation="Continue"
                 ContextMenu="{StaticResource CellMenu}"
                 PreviewGotKeyboardFocus="Cells_PreviewGotKeyboardFocus"
                 PreviewMouseDown="Cells_PreviewMouseDown"
                 AllowDrop="True"
                 PreviewDragOver="Cells_PreviewDragOver"
                 PreviewDrop="Cells_PreviewDrop"
                 DragOver="Cells_DragOver"
                 Drop="Cells_Drop"
                 AutomationProperties.Name="Document">
            <ListBox.LayoutTransform>
                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
            </ListBox.LayoutTransform>
        </ListBox>
    </DockPanel>
</Window>
